# Generate Token in Fluxer Settings under "Developer"
FLUXER_TOKEN=
# should take the default fluxer server if empty
FLUXER_API_URL=

LOG_LEVEL=INFO # DEBUG, INFO, WARNING, ERROR, CRITICAL
INTERVAL=3600 # 1 hour
SUBREDDIT=ich_iel
COMMAND_PREFIX="/" # Prefix for bot commands, default is "/"
POST_LIMIT=20 # How many posts to fetch from reddit each time